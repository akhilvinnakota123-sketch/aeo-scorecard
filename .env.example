# Rename this file to .env.local and fill in your keys

# 1. OpenAI → https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# 2. Anthropic → https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# 3. Google Gemini → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# 4. Rainforest API (Amazon scraping) → https://www.rainforestapi.com
# Leave as "demo" if you don't have one — manual listing paste still works
RAINFOREST_API_KEY=demo
